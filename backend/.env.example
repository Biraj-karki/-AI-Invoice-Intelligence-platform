# Copy this file to .env and fill in the values.
# .env is gitignored; .env.example is committed as documentation.

ENVIRONMENT=local

# Comma-separated list of browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# PostgreSQL connection string (driver: psycopg 3).
DATABASE_URL=postgresql+psycopg://invoice_user:CHANGE_ME@127.0.0.1:5432/invoice_db

# Get a key at https://aistudio.google.com/apikey - leave blank until the AI step.
GEMINI_API_KEY=

# Structured-extraction model. Current options: gemini-3.8-flash, gemini-4-argon.
GEMINI_MODEL=gemini-3.8-flash
