# Copy this file to .env and fill in the values.
# .env is gitignored; .env.example is committed as documentation.

ENVIRONMENT=local

# Comma-separated list of browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# PostgreSQL connection string (driver: psycopg 3).
DATABASE_URL=postgresql+psycopg://invoice_user:CHANGE_ME@127.0.0.1:5432/invoice_db

# Get a key at https://aistudio.google.com/apikey - leave blank until the AI step.
GEMINI_API_KEY=

# Signs session tokens. Generate one before deploying:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=CHANGE_ME
ACCESS_TOKEN_MINUTES=1440

# true while you are building. Set false once your own account exists, so
# strangers cannot create accounts on a deployed instance.
ALLOW_REGISTRATION=true

# Structured-extraction model. Current options: gemini-3.6-flash, gemini-3.8-flash.
GEMINI_MODEL=gemini-3.6-flash
# Tried in order if the primary model is overloaded (503/429).
GEMINI_FALLBACK_MODELS=gemini-3.8-flash,gemini-3.5-flash-lite
GEMINI_TIMEOUT_SECONDS=90
